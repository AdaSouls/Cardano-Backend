{
  "name": "cardano-backend",
  "version": "1.0.0",
  "description": "AdaSouls Cardano Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "dev": "cross-env NODE_ENV=local nodemon src/index.js",
    "dev2": "cross-env nodemon src/index.js",
    "migrator": "node src/database/migrator.js",
    "test": "jest -i --colors --verbose --detectOpenHandles",
    "test:watch": "jest -i --watchAll",
    "coverage": "jest -i --coverage",
    "coverage:coveralls": "jest -i --coverage --coverageReporters=text-lcov | coveralls",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.js",
    "prettier:fix": "prettier --write **/*.js"
  },
  "keywords": [
    "node",
    "node.js",
    "cardano",
    "backend",
    "express",
    "rest",
    "api",
    "postgres",
    "jwt",
    "blockfrost"
  ],
  "dependencies": {
    "@blockfrost/blockfrost-js": "^5.5.0",
    "@emurgo/cardano-message-signing-nodejs": "^1.0.1",
    "@emurgo/cardano-serialization-lib-nodejs": "^11.5.0",
    "axios": "^1.7.4",
    "basic-auth-connect": "^1.1.0",
    "basic-ftp": "^5.2.0",
    "body-parser": "^1.20.3",
    "braces": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.0",
    "debug": "^2.6.9",
    "diceware-word": "^1.0.0",
    "dotenv": "^10.0.0",
    "elliptic": "^6.6.1",
    "email-validator": "^2.0.4",
    "ethereum-public-key-to-address": "^0.0.5",
    "ethers": "^5.7.2",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.0.0",
    "form-data": "^4.0.4",
    "fresh": "^0.5.2",
    "helmet": "^4.1.0",
    "http-status": "^1.4.0",
    "joi": "^17.3.0",
    "jsonwebtoken": "^9.0.2",
    "jws": "^3.2.3",
    "lodash": "^4.17.11",
    "mime": "^1.4.1",
    "minimatch": "^3.1.3",
    "minimist": "^0.2.4",
    "morgan": "^1.9.1",
    "negotiator": "^0.6.1",
    "path-to-regexp": "^0.1.10",
    "pg": "^8.11.3",
    "pinata": "^1.4.1",
    "pm2": "^5.1.0",
    "qs": "^6.0.4",
    "redis": "^4.6.13",
    "rsa-pem-from-mod-exp": "^0.8.6",
    "secp256k1": "^4.0.4",
    "sequelize": "^6.37.8",
    "swagger-node-express": "~2.0",
    "systeminformation": "^5.27.14",
    "umzug": "^3.2.1",
    "validator": "^13.15.22",
    "winston": "^3.2.1",
    "ws": "^7.5.10",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.7",
    "coveralls": "^3.0.7",
    "eslint": "^7.0.0",
    "jest": "^26.0.1",
    "node-mocks-http": "^1.8.0",
    "nodemon": "^2.0.0",
    "prettier": "^2.0.5"
  }
}
